# Avorria V2 Production Environment Variables
# ============================================
# IMPORTANT: Never commit real secret values to version control.
# Copy this file to .env.local and fill in actual values for local development.
# Production secrets are configured via your hosting platform (e.g. Vercel dashboard).

# === CORE SITE (REQUIRED) ===
# The canonical production URL — used for SEO metadata, OG images, JSON-LD schema
NEXT_PUBLIC_SITE_URL=https://avorria.com

# === OPTIONAL DEMOS — SERVER-SIDE ONLY ===
# Never use NEXT_PUBLIC_ prefix for these — they must never appear in client-side bundles
CAREER_DEMO_API_KEY=            # Gemini API key for live CareerOS career path demo
                                # Fallback: deterministic response served if absent
GEMINI_API_KEY=                 # Generic Gemini/Google AI key (server-side routes only)

# === OPTIONAL INTEGRATIONS ===
NEXT_PUBLIC_ANALYTICS_ID=       # Analytics tracking ID — intentionally public, non-sensitive
ENQUIRY_WEBHOOK_URL=            # Server-side webhook for start-project form submission
ENQUIRY_NOTIFICATION_EMAIL=     # Routing email for new project enquiries

# === ADMIN OPERATING SYSTEM (SERVER-SIDE ONLY) ===
ADMIN_SESSION_SECRET=           # Cryptographic secret for signing session cookies (min 32 chars)
ADMIN_SUPERADMIN_EMAIL=pete@avorria.com
ADMIN_SUPERADMIN_PASSWORD=      # Initial superadmin password for local development

# === SUPABASE / DATABASE (OPTIONAL / PHASE 1 ARCHITECTURE) ===
NEXT_PUBLIC_SUPABASE_URL=       # Supabase project URL
NEXT_PUBLIC_SUPABASE_ANON_KEY=  # Supabase public anonymous key
SUPABASE_SERVICE_ROLE_KEY=      # Server-only service role key with admin privileges

# === ENVIRONMENT CLASSIFICATION ===
# REQUIRED FOR CORE SITE:   NEXT_PUBLIC_SITE_URL
# REQUIRED FOR AI DEMO:     CAREER_DEMO_API_KEY or GEMINI_API_KEY (server-only)
# REQUIRED FOR ANALYTICS:   NEXT_PUBLIC_ANALYTICS_ID
# REQUIRED FOR CONTACT:     ENQUIRY_WEBHOOK_URL, ENQUIRY_NOTIFICATION_EMAIL
# REQUIRED FOR ADMIN:       ADMIN_SESSION_SECRET, ADMIN_SUPERADMIN_EMAIL, ADMIN_SUPERADMIN_PASSWORD
# SERVER-ONLY (never NEXT_PUBLIC):  ADMIN_SESSION_SECRET, ADMIN_SUPERADMIN_PASSWORD, SUPABASE_SERVICE_ROLE_KEY, CAREER_DEMO_API_KEY, GEMINI_API_KEY, ENQUIRY_WEBHOOK_URL, ENQUIRY_NOTIFICATION_EMAIL

