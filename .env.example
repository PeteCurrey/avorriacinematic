# ── OUTBOUND EMAIL SAFETY GATE ─────────────────────────────────────────────
# Live sending requires BOTH an API key AND this set to exactly "true".
# A key on its own is not consent to email real people — this stops a
# misconfigured preview deployment from mailing a live prospect list.
# Leave unset everywhere except production.
AVORRIA_EMAIL_LIVE=

# ── OUTREACH KILL SWITCH ───────────────────────────────────────────────────
# Halts the outreach sequencer only. Distinct from AVORRIA_EMAIL_LIVE: this
# stops cold sequences without disabling transactional mail (proposals,
# deposit receipts, reply notifications). Set to "true" to stop all outreach.
AVORRIA_OUTREACH_PAUSED=
